            @foreach($courses as $course)
                @php
                    $courseTotalAssignments = $course->terms->sum(function($term) {
                        return $term->subTerms->sum(function($subTerm) {
                            return $subTerm->weeks->sum(function($week) {
                                return $week->assignments->count();
                            });
                        });
                    });
                    $courseSubmittedAssignments = $course->terms->sum(function($term) {
                        return $term->subTerms->sum(function($subTerm) {
                            return $subTerm->weeks->sum(function($week) {
                                return $week->assignments->filter(function($assignment) {
                                    $sub = $assignment->submissions->first();
                                    return $sub && $sub->status !== 'draft';
                                })->count();
                            });
                        });
                    });
                    $courseGradedAssignments = $course->terms->sum(function($term) {
                        return $term->subTerms->sum(function($subTerm) {
                            return $subTerm->weeks->sum(function($week) {
                                return $week->assignments->filter(function($assignment) {
                                    $sub = $assignment->submissions->first();
                                    return $sub && $sub->status === 'graded';
                                })->count();
                            });
                        });
                    });
                @endphp
                
